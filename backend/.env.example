# Copy this file to .env and fill in the values.
# Get the Firebase values from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key.

PORT=5000
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the quotes; the \n sequences are converted to real newlines on load.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Safety guard for the seed script (scripts/seed.js). The script refuses to run
# unless SEED=true in the environment OR you pass --confirm on the command line.
SEED=false
